rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is a member of a household
    function isHouseholdMember(householdId) {
      return isAuthenticated() && 
             request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.memberIds;
    }
    
    // Households collection
    match /households/{householdId} {
      // Anyone authenticated can create a household
      allow create: if isAuthenticated() &&
                      request.resource.data.createdBy == request.auth.uid &&
                      request.auth.uid in request.resource.data.memberIds;
      
      // Only household members can read
      allow read: if isHouseholdMember(householdId);
      
      // Only household members can update
      allow update: if isHouseholdMember(householdId);
      
      // Prevent deletion for data integrity
      allow delete: if false;
      
      // Household members subcollection
      match /members/{userId} {
        allow read: if isHouseholdMember(householdId);
        allow write: if isHouseholdMember(householdId);
      }
    }
    
    // Expenses collection
    match /expenses/{householdId}/expenses/{expenseId} {
      // Only household members can read expenses
      allow read: if isHouseholdMember(householdId);
      
      // Only household members can create expenses
      allow create: if isHouseholdMember(householdId) &&
                      request.resource.data.householdId == householdId &&
                      request.resource.data.createdBy == request.auth.uid;
      
      // Only household members can update expenses
      allow update: if isHouseholdMember(householdId) &&
                      request.resource.data.householdId == householdId &&
                      request.resource.data.modifiedBy == request.auth.uid;
      
      // Only household members can delete expenses
      allow delete: if isHouseholdMember(householdId);
    }
    
    // Categories collection
    match /categories/{householdId}/categories/{categoryId} {
      // Only household members can read categories
      allow read: if isHouseholdMember(householdId);
      
      // Only household members can create categories
      allow create: if isHouseholdMember(householdId) &&
                      request.resource.data.householdId == householdId &&
                      request.resource.data.createdBy == request.auth.uid;
      
      // Only household members can update categories
      allow update: if isHouseholdMember(householdId) &&
                      request.resource.data.householdId == householdId &&
                      request.resource.data.modifiedBy == request.auth.uid;
      
      // Only household members can delete categories
      allow delete: if isHouseholdMember(householdId);
    }
  }
}